  "components": [
    {
      "id": "comp_arrival_p",
      "family": "fam_arrival",
      "type": "premise",
      "text": "I moved to Austin with $180 and a dream.",
      "styles": [
        "self_deprecating",
        "storytelling"
      ],
      "quality": 3,
      "originality": 3,
      "difficulty": 2,
      "seconds": 5,
      "unlock": "start"
    },
    {
      "id": "comp_arrival_s",
      "family": "fam_arrival",
      "type": "setup",
      "text": "Everybody here says 'Keep Austin weird.' I took that as a housing plan.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 3,
      "originality": 3,
      "difficulty": 2,
      "seconds": 12,
      "unlock": "start"
    },
    {
      "id": "comp_arrival_u1",
      "family": "fam_arrival",
      "type": "punchline",
      "text": "Turns out weird costs nineteen hundred a month plus utilities.",
      "styles": [
        "observational"
      ],
      "quality": 3,
      "originality": 2,
      "difficulty": 2,
      "seconds": 6,
      "unlock": "start"
    },
    {
      "id": "comp_arrival_u2",
      "family": "fam_arrival",
      "type": "punchline",
      "text": "My budget's so tight the hostel listed me as a fixture.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 7,
      "originality": 6,
      "difficulty": 4,
      "seconds": 6,
      "unlock": "writing",
      "min_skill": 12
    },
    {
      "id": "comp_arrival_t",
      "family": "fam_arrival",
      "type": "tag",
      "text": "Even the bats under the bridge have roommates.",
      "styles": [
        "absurdist"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 4,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_hostel_p",
      "family": "fam_hostel",
      "type": "premise",
      "text": "Sharing a hostel room with eleven strangers.",
      "styles": [
        "storytelling"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 5,
      "unlock": "observe:hostel_bunks"
    },
    {
      "id": "comp_hostel_s",
      "family": "fam_hostel",
      "type": "setup",
      "text": "There's a guy in the top bunk who's been 'between apartments' since two presidents ago.",
      "styles": [
        "storytelling",
        "observational"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 3,
      "seconds": 14,
      "unlock": "writing"
    },
    {
      "id": "comp_hostel_u1",
      "family": "fam_hostel",
      "type": "punchline",
      "text": "He calls it a gap year. It's a gap decade.",
      "styles": [
        "observational"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_hostel_u2",
      "family": "fam_hostel",
      "type": "punchline",
      "text": "He's not a guest anymore. Legally, he's load-bearing.",
      "styles": [
        "absurdist",
        "deadpan"
      ],
      "quality": 8,
      "originality": 7,
      "difficulty": 4,
      "seconds": 5,
      "unlock": "writing",
      "min_skill": 15
    },
    {
      "id": "comp_hostel_t",
      "family": "fam_hostel",
      "type": "tag",
      "text": "If he ever checks out, the whole building comes down with him.",
      "styles": [
        "absurdist"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 3,
      "seconds": 6,
      "unlock": "writing"
    },
    {
      "id": "comp_hostel_cb",
      "family": "fam_hostel",
      "type": "callback",
      "callback_ref": "fam_hostel",
      "text": "Anyway, my bunkmate says hi. He can't come. He's holding up the second floor.",
      "styles": [
        "absurdist"
      ],
      "quality": 7,
      "originality": 7,
      "difficulty": 5,
      "seconds": 6,
      "unlock": "writing",
      "requires": [
        "fam_arrival_punch",
        "fam_parents_punch",
        "fam_dating_punch",
        "fam_bombing_punch"
      ]
    },
    {
      "id": "comp_diner_p",
      "family": "fam_diner",
      "type": "premise",
      "text": "Waiting tables at brunch.",
      "styles": [
        "observational"
      ],
      "quality": 4,
      "originality": 3,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "job:server"
    },
    {
      "id": "comp_diner_s",
      "family": "fam_diner",
      "type": "setup",
      "text": "Brunch people order like it's a hostage negotiation: 'Eggs. No yolk. No white. And I'll know if you hesitate.'",
      "styles": [
        "observational",
        "high_energy"
      ],
      "quality": 6,
      "originality": 5,
      "difficulty": 4,
      "seconds": 15,
      "unlock": "writing"
    },
    {
      "id": "comp_diner_u1",
      "family": "fam_diner",
      "type": "punchline",
      "text": "Ma'am, that's just a plate.",
      "styles": [
        "deadpan"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "writing"
    },
    {
      "id": "comp_diner_u2",
      "family": "fam_diner",
      "type": "punchline",
      "text": "So I brought her an empty plate. She tipped thirty percent and called it 'honest.'",
      "styles": [
        "storytelling"
      ],
      "quality": 8,
      "originality": 7,
      "difficulty": 4,
      "seconds": 7,
      "unlock": "writing",
      "min_skill": 14
    },
    {
      "id": "comp_diner_t",
      "family": "fam_diner",
      "type": "tag",
      "text": "The chef framed it. Only dish we've never gotten a complaint about.",
      "styles": [
        "observational"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 3,
      "seconds": 6,
      "unlock": "writing"
    },
    {
      "id": "comp_door_p",
      "family": "fam_door",
      "type": "premise",
      "text": "Checking IDs at a comedy club door.",
      "styles": [
        "observational"
      ],
      "quality": 4,
      "originality": 3,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "job:doorman"
    },
    {
      "id": "comp_door_s",
      "family": "fam_door",
      "type": "setup",
      "text": "Forty-year-old men hand me their ID like it's a confession. 'It's an old picture. I had hair.'",
      "styles": [
        "observational",
        "storytelling"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 3,
      "seconds": 13,
      "unlock": "writing"
    },
    {
      "id": "comp_door_u1",
      "family": "fam_door",
      "type": "punchline",
      "text": "Sir, it's a driver's license, not a before-and-after.",
      "styles": [
        "deadpan"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_door_u2",
      "family": "fam_door",
      "type": "punchline",
      "text": "One guy's ID was so old the photo was a painting.",
      "styles": [
        "absurdist"
      ],
      "quality": 7,
      "originality": 7,
      "difficulty": 3,
      "seconds": 5,
      "unlock": "writing",
      "min_skill": 12
    },
    {
      "id": "comp_door_t",
      "family": "fam_door",
      "type": "tag",
      "text": "Oil on canvas. He was squinting at a horse.",
      "styles": [
        "absurdist"
      ],
      "quality": 6,
      "originality": 7,
      "difficulty": 3,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_door_ao",
      "family": "fam_door",
      "type": "act_out",
      "text": "[Act it out: the man in the painting, squinting nobly at a distant horse.]",
      "styles": [
        "high_energy"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 5,
      "seconds": 8,
      "unlock": "writing"
    },
    {
      "id": "comp_delivery_p",
      "family": "fam_delivery",
      "type": "premise",
      "text": "Doing food delivery on a bike in Austin.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "job:delivery"
    },
    {
      "id": "comp_delivery_s",
      "family": "fam_delivery",
      "type": "setup",
      "text": "The app rates me out of five stars, like I'm a hotel and not a sweaty guy holding your queso.",
      "styles": [
        "self_deprecating",
        "observational"
      ],
      "quality": 6,
      "originality": 5,
      "difficulty": 3,
      "seconds": 13,
      "unlock": "writing"
    },
    {
      "id": "comp_delivery_u1",
      "family": "fam_delivery",
      "type": "punchline",
      "text": "I got three stars because the queso was 'emotionally cold.'",
      "styles": [
        "observational"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 3,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_delivery_u2",
      "family": "fam_delivery",
      "type": "punchline",
      "text": "One guy gave me one star and wrote 'he looked like he needed it more.' He was right. I ate it at a red light.",
      "styles": [
        "self_deprecating",
        "storytelling"
      ],
      "quality": 8,
      "originality": 7,
      "difficulty": 4,
      "seconds": 9,
      "unlock": "writing",
      "min_skill": 15
    },
    {
      "id": "comp_delivery_t",
      "family": "fam_delivery",
      "type": "tag",
      "text": "Best review I ever got was from me.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "writing"
    },
    {
      "id": "comp_heat_p",
      "family": "fam_heat",
      "type": "premise",
      "text": "Austin summer heat.",
      "styles": [
        "observational"
      ],
      "quality": 3,
      "originality": 2,
      "difficulty": 1,
      "seconds": 3,
      "unlock": "observe:bank_thermometer"
    },
    {
      "id": "comp_heat_s",
      "family": "fam_heat",
      "type": "setup",
      "text": "It was a hundred and eight today. The weatherman just showed a picture of a skillet and went home.",
      "styles": [
        "observational"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 2,
      "seconds": 11,
      "unlock": "writing"
    },
    {
      "id": "comp_heat_u1",
      "family": "fam_heat",
      "type": "punchline",
      "text": "Even my sweat was sweating.",
      "styles": [
        "observational"
      ],
      "quality": 3,
      "originality": 2,
      "difficulty": 1,
      "seconds": 3,
      "unlock": "writing"
    },
    {
      "id": "comp_heat_u2",
      "family": "fam_heat",
      "type": "punchline",
      "text": "I watched a lizard cross the sidewalk at a full sprint, screaming. Lizards can't scream. This one learned.",
      "styles": [
        "absurdist",
        "storytelling"
      ],
      "quality": 8,
      "originality": 8,
      "difficulty": 4,
      "seconds": 8,
      "unlock": "writing",
      "min_skill": 14
    },
    {
      "id": "comp_heat_t",
      "family": "fam_heat",
      "type": "tag",
      "text": "He's doing open mics now. Better closer than me.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 7,
      "originality": 6,
      "difficulty": 3,
      "seconds": 5,
      "unlock": "writing"
    },
    {
      "id": "comp_heat_ao",
      "family": "fam_heat",
      "type": "act_out",
      "text": "[Act it out: the lizard's sprint, arms pinwheeling, silent scream.]",
      "styles": [
        "high_energy"
      ],
      "quality": 7,
      "originality": 7,
      "difficulty": 6,
      "seconds": 9,
      "unlock": "start_bg:theater_kid"
    },
    {
      "id": "comp_heat_cb",
      "family": "fam_heat",
      "type": "callback",
      "callback_ref": "fam_heat",
      "text": "Which is how I feel about my career. Like that lizard. Sprinting. Screaming. Technically unable to.",
      "styles": [
        "absurdist",
        "self_deprecating"
      ],
      "quality": 7,
      "originality": 7,
      "difficulty": 5,
      "seconds": 7,
      "unlock": "writing",
      "requires": [
        "fam_bucket_punch",
        "fam_arrival_punch",
        "fam_bombing_punch",
        "fam_parents_punch"
      ]
    },
    {
      "id": "comp_scooter_p",
      "family": "fam_scooter",
      "type": "premise",
      "text": "Electric scooters everywhere.",
      "styles": [
        "observational"
      ],
      "quality": 3,
      "originality": 3,
      "difficulty": 1,
      "seconds": 3,
      "unlock": "observe:scooter_pile"
    },
    {
      "id": "comp_scooter_s",
      "family": "fam_scooter",
      "type": "setup",
      "text": "Austin has more scooters than people, and they're all face-down on the sidewalk like a crime scene.",
      "styles": [
        "observational"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 2,
      "seconds": 10,
      "unlock": "writing"
    },
    {
      "id": "comp_scooter_u1",
      "family": "fam_scooter",
      "type": "punchline",
      "text": "Nobody rides them. They just faint from the heat.",
      "styles": [
        "observational"
      ],
      "quality": 4,
      "originality": 4,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "writing"
    },
    {
      "id": "comp_scooter_u2",
      "family": "fam_scooter",
      "type": "punchline",
      "text": "I don't think they're abandoned. I think they're praying.",
      "styles": [
        "absurdist",
        "deadpan"
      ],
      "quality": 7,
      "originality": 7,
      "difficulty": 3,
      "seconds": 4,
      "unlock": "writing",
      "min_skill": 10
    },
    {
      "id": "comp_scooter_t",
      "family": "fam_scooter",
      "type": "tag",
      "text": "Toward the one charging station. Their holy site has a forty-minute wait.",
      "styles": [
        "absurdist"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 4,
      "seconds": 6,
      "unlock": "writing"
    },
    {
      "id": "comp_scooter_ao",
      "family": "fam_scooter",
      "type": "act_out",
      "text": "[Act it out: a scooter slowly tipping over with a long, tired sigh.]",
      "styles": [
        "high_energy"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 5,
      "seconds": 7,
      "unlock": "writing"
    },
    {
      "id": "comp_parents_p",
      "family": "fam_parents",
      "type": "premise",
      "text": "Telling my parents I'm doing comedy.",
      "styles": [
        "storytelling",
        "self_deprecating"
      ],
      "quality": 4,
      "originality": 3,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "start_bg:small_town"
    },
    {
      "id": "comp_parents_s",
      "family": "fam_parents",
      "type": "setup",
      "text": "I told my dad I moved to Austin to do standup. He went quiet, then asked, 'Is that the one where you stand?'",
      "styles": [
        "storytelling"
      ],
      "quality": 5,
      "originality": 5,
      "difficulty": 3,
      "seconds": 12,
      "unlock": "start_bg:small_town"
    },
    {
      "id": "comp_parents_u1",
      "family": "fam_parents",
      "type": "punchline",
      "text": "Yes, Dad. That's most of it.",
      "styles": [
        "deadpan"
      ],
      "quality": 5,
      "originality": 4,
      "difficulty": 2,
      "seconds": 4,
      "unlock": "writing"
    },
    {
      "id": "comp_parents_u2",
      "family": "fam_parents",
      "type": "punchline",
      "text": "Now he tells his friends I'm 'in the standing industry.' Three of them asked if I can get them forklift certified.",
      "styles": [
        "storytelling",
        "absurdist"
      ],
      "quality": 8,
      "originality": 7,
      "difficulty": 4,
      "seconds": 9,
      "unlock": "writing",
      "min_skill": 14
    },
    {
      "id": "comp_parents_t",
      "family": "fam_parents",
      "type": "tag",
      "text": "I have a callback Tuesday.",
      "styles": [
        "deadpan"
      ],
      "quality": 6,
      "originality": 6,
      "difficulty": 3,
      "seconds": 3,
      "unlock": "writing"
    },
    {
      "id": "comp_dating_p",
      "family": "fam_dating",
      "type": "premise",
      "text": "Dating apps in a new city.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 3,
      "originality": 2,
      "difficulty": 2,
      "seconds": 3,
      "unlock": "observe:app_billboard"
    },
    {
      "id": "comp_dating_s",
      "family": "fam_dating",
      "type": "setup",
      "text": "I updated my dating profile to say 'comedian.' My matches dropped eighty percent.",
      "styles": [
        "self_deprecating"
      ],
      "quality": 5,
      "originality": 4,
      "difficulty": 2,
      "seconds": 9,
      "unlock": "writing"
    },
    {
      "id": "comp_dating_u1",
      "family": "fam_dating",
      "type": "punchline",
      "text": "The other twenty percent were also comedians, asking for stage time.",
      "styles": [
        "observational"
      ],
      "quality": 6,
      "originality": 5,
      "difficulty": 3,
      "seconds": 6,
      "unlock": "writing"
    },
    {
      "id": "comp_dating_u2",
      "family": "fam_dating",
      "type": "punchline",
      "text": "So I changed it to 'unemployed' and matches went up. Women respect honesty. They do not respect open mics.",
      "styles": [
        "self_deprecating",
        "storytelling"
      ],
      "quality": 7,
      "originality": 6,
      "difficulty": 4,
      "seconds": 9,
      "unlock": "writing",
      "min_skill": 12
    },
    {
      "id": "comp_dating_t",
